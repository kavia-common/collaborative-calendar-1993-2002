# Frontend environment variables for Calendar app
# IMPORTANT: Do not commit real secrets. Copy this file to .env and fill values for your environment.

# Base URL of the backend API (e.g., http://localhost:8000 or /api when proxied)
REACT_APP_API_BASE_URL=http://localhost:8000

# Public site URL used by auth providers (if applicable)
REACT_APP_SITE_URL=http://localhost:3000
